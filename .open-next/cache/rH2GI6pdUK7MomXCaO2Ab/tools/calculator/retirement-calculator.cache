c=\"\"></script><script src=\"/_next/static/chunks/3af05diwnz5-0.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-1h_jd2iuygtkh.js\" async=\"\"></script><script src=\"/_next/static/chunks/2edz9v6g4tymq.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/3jrw_n8ypxygi.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/13iielltt4jag.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/2xno31ocjad8l.js\" async=\"\" crossorigin=\"\"></script><script async=\"\" src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1267608571294570\" crossorigin=\"anonymous\"></script><meta name=\"theme-color\" content=\"#000000\"/><title>Retirement Calculator | FIRE &amp; SWP Planner | atoolix</title><meta name=\"description\" content=\"Plan retirement with corpus, FIRE target, and SWP withdrawal calculators. View inflation-adjusted income, growth charts, and a downloadable year-by-year PDF report.\"/><meta name=\"application-name\" content=\"atoolix\"/><link rel=\"author\" href=\"https://atoolix.com\"/><meta name=\"author\" content=\"atoolix\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"keywords\" content=\"retirement calculator india,fire calculator,swp calculator,retirement corpus calculator,financial independence calculator,systematic withdrawal plan calculator,retirement planning calculator,when can i retire calculator\"/><meta name=\"creator\" content=\"atoolix\"/><meta name=\"publisher\" content=\"atoolix\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://atoolix.com/tools/calculator/retirement-calculator\"/><meta name=\"mobile-web-app-capable\" content=\"yes\"/><meta name=\"apple-mobile-web-app-title\" content=\"atoolix\"/><meta name=\"apple-mobile-web-app-status-bar-style\" conte