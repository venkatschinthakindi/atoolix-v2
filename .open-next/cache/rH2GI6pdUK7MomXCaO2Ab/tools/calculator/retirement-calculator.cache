,\"children\":\"How much money is needed to retire in India?\"}]}],[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0 -transform duration-300\",\"children\":[\"$\",\"svg\",null,{\"className\":\"w-5 h-5 transform -transform duration-300 open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2,\"d\":\"M19 9l-7 7-7-7\"}]}]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 pt-0 border-t border-white/5 border-dashed\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3 mt-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0\",\"children\":\"💡\"}],[\"$\",\"p\",null,{\"className\":\"text-white/60 text-xs leading-relaxed\",\"children\":\"There is no single number for everyone in India because retirement needs depend on city, lifestyle, healthcare expectations, inflation, and family responsibilities. A retirement corpus calculator can estimate a more personalized target based on your annual expenses and withdrawal rate.\"}]]}]}]]}]}]\n5f:[\"$\",\"div\",\"19\",{\"className\":\"group rounded-2xl border border-white/10 bg-white/5 overflow-hidden  duration-300\",\"children\":[\"$\",\"details\",null,{\"className\":\"w-full\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"list-none p-5 flex items-center justify-between gap-4 hover:bg-white/10   cursor-pointer\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 flex-1\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-white font-semibold text-sm\",\"children\":\"Is SWP better than FD income?\"}]}],[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0 -transform duration-300\",\"children\":[\"$\",\"svg\",null,{\"className\":\"w-5 h-5 transform -transform duration-300 open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",