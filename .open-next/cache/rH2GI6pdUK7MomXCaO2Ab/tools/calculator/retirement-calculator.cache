\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2,\"d\":\"M19 9l-7 7-7-7\"}]}]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 pt-0 border-t border-white/5 border-dashed\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3 mt-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0\",\"children\":\"💡\"}],[\"$\",\"p\",null,{\"className\":\"text-white/60 text-xs leading-relaxed\",\"children\":\"If inflation rises faster than expected, your future expenses will increase and your corpus may need to be larger than originally planned. This is why many retirement plans use a margin of safety and review assumptions regularly.\"}]]}]}]]}]}]\n53:[\"$\",\"div\",\"15\",{\"className\":\"group rounded-2xl border border-white/10 bg-white/5 overflow-hidden  duration-300\",\"children\":[\"$\",\"details\",null,{\"className\":\"w-full\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"list-none p-5 flex items-center justify-between gap-4 hover:bg-white/10   cursor-pointer\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 flex-1\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-white font-semibold text-sm\",\"children\":\"Should I include pensions in retirement planning?\"}]}],[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0 -transform duration-300\",\"children\":[\"$\",\"svg\",null,{\"className\":\"w-5 h-5 transform -transform duration-300 open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2,\"d\":\"M19 9l-7 7-7-7\"}]}]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 pt-0 border-t border-white/5 border-dashed\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3 mt-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0\",\"children\":\"💡\"}],[\"$\",\"p\",null,{\"className\":\"text-white/60 text-xs leading-relaxed\",\"children\":\"Yes, any guaranteed pension or recurring income should be included because it can reduce the amount you need to withdraw from your own corpus. It is still wise to keep a buffer in case the pension starts later than expected or does not fully cover expenses.\"}]]}]}]]}]}]\n54:[\"$\",\"div\",\"16\",{\"className\":\"group rounded-2xl border border-white/10 bg-white/5 overflow-hidden  duration-300\",\"children\":[\"$\",\"details\",null,{\"className\":\"w-full\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"list-none p-5 flex items-center justify-between gap-4 hover:bg-white/10   cursor-pointer\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 flex-1\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-white font-semibold text-sm\",\"children\":\"Can I use SIPs for retirement planning?\"}]}],[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0 -transform duration-300\",\"children\":[\"$\",\"svg\",null,{\"className\":\"w-5 h-5 transform -transform duration-300 open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2,\"d\":\"M19 9l-7 7-7-7\"}]}]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 pt-0 border-t border-white/5 border-dashed\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3 mt-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0\",\"children\":\"💡\"}],[\"$\",\"p\",null,{\"className\":\"text-white/60 text-xs leading-relaxed\",\"children\":\"Yes, SIPs are one of the most common ways to build retirement wealth because they encourage disciplined monthly investing. A SIP calculator or retirement planner can help you estimate how much you need to invest every month to reach your target corpus.\"}]]}]}]]}]}]\n55:[\"$\",\"div\",\"17\",{\"className\":\"group rounded-2xl border border-white/10 bg-white/5 overflow-hidden  duration-300\",\"children\":[\"$\",\"details\",null,{\"className\":\"w-full\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"list-none p-5 flex items-center justify-between gap-4 hover:bg-white/10   cursor-pointer\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 flex-1\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-white font-semibold text-sm\",\"children\":\"How much should I save every month for retirement?\"}]}],[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0 -transform duration-300\",\"children\":[\"$\",\"svg\",null,{\"className\":\"w-5 h-5 transform -transform duration-300 open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2,\"d\":\"M19 9l-7 7-7-7\"}]}]}]]}],[\"$\",\"div\",null,{\"className\":\"p-5 pt-0 border-t border-white/5 border-dashed\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3 mt-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-blue-400 text-lg flex-shrink-0\",\"children\":\"💡\"}],[\"$\",\"p\",null,{\"className\":\"text-white/60 text-xs leading-relaxed\",\"children\":\"The monthly amount depends on your current savings, years left until retirement, expected return, inflation, and target corpus. A retirement planning calculator helps translate the goal into a monthly savings number you can act on.\"}]]}]}]]}]}]\n56:[\"$\",\"div\",\"18\",{\"className\":\"group rounded-2xl border border-white/10 bg-white/5 overflow-hidden  duration-300\",\"children\":[\"$\",\"details\",null,{\"className\":\"w-full\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"list-none p-5 flex items-center justify-between gap-4 hover:bg-white/10   cursor-pointer\",\"children\":[[\"$\",\"div\",null,{\"