location Education\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs leading-6 text-white/65\",\"children\":\"Learn how equity and debt allocation change risk and growth potential.\"}]]}],[\"$\",\"article\",\"Mobile-Friendly SEO Layout\",{\"className\":\"rounded-2xl border border-white/10 bg-white/5 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl\",\"children\":\"⚡\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 text-sm font-semibold\",\"children\":\"Mobile-Friendly SEO Layout\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs leading-6 text-white/65\",\"children\":\"Fast-loading semantic page with strong long-tail keyword coverage.\"}]]}]]}]]}]\n3b:[\"$\",\"section\",null,{\"aria-labelledby\":\"howto-heading\",\"className\":\"space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"howto-heading\",\"className\":\"text-2xl font-semibold tracking-tight\",\"children\":\"How to Plan Your Retirement\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2\",\"children\":[[\"$\",\"article\",\"Estimate your annual expenses\",{\"className\":\"rounded-2xl border border-white/10 bg-white/5 p-5\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-full bg-white text-sm font-bold text-black\",\"children\":1}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold\",\"children\":\"Estimate your annual expenses\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-xs leading-6 text-white/65\",\"children\":\"Start with your current yearly spending and adjust for future lifestyle goals, healthcare, and inflation.\"}]]}]]}]}],[\"$\",\"article\",\"Choose a safe withdrawal rate\",{\"className\":\"rounded-2xl border border-white/10 bg-white/5 p-5\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center just